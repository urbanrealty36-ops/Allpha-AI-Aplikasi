# Allpha API production/runtime environment template.
# Never commit real credentials. Set values in the Railway Allpha-AI-Aplikasi service environment.

ALLPHA_ENVIRONMENT=production
ALLPHA_CORS_ORIGINS=https://allpha.web.id,https://adm.allpha.web.id,http://localhost:3000,http://localhost:3001,http://localhost:19006,http://localhost:8081
# Private Supabase Storage bucket for signed Spatial GLB URLs; public manifest still requires the service-role key.
ALLPHA_SPATIAL_ASSET_BUCKET=allpha-spatial-assets
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Consent recording stays fail-closed until the approved legal/policy versions are published.
# Set only the exact versions approved for the current Terms, Privacy and optional product updates.
ALLPHA_POLICY_VERSION_TERMS_OF_SERVICE=
ALLPHA_POLICY_VERSION_PRIVACY_POLICY=
ALLPHA_POLICY_VERSION_PRODUCT_UPDATES=
# Legacy cron authorization; server-side only, never expose to clients. Railway worker/scheduler ownership is governed by WORKERS.md.
CRON_SECRET=

# Text generation is intentionally disabled until a provider, model, pricing,
# cost ceiling and explicit policy approval are configured. Compatible with an
# OpenAI Chat Completions-style endpoint; BASE_URL should include its API version.
ALLPHA_TEXTGEN_BASE_URL=
ALLPHA_TEXTGEN_API_KEY=
ALLPHA_TEXTGEN_PROVIDER_ID=
ALLPHA_TEXTGEN_MODEL_ID=
ALLPHA_TEXTGEN_MODEL_VERSION=
ALLPHA_TEXTGEN_POLICY_ID=
ALLPHA_TEXTGEN_POLICY_VERSION=
ALLPHA_TEXTGEN_POLICY_APPROVED=false
ALLPHA_TEXTGEN_PRICING_VERSION=
ALLPHA_TEXTGEN_COST_UNIT=USD
# Cost values are in the smallest configured currency unit (for USD, microdollars).
# Do not guess these; copy from the selected provider's current pricing contract.
ALLPHA_TEXTGEN_INPUT_MICRO_COST_PER_TOKEN=
ALLPHA_TEXTGEN_OUTPUT_MICRO_COST_PER_TOKEN=
ALLPHA_TEXTGEN_MAX_COST_MICROUNITS=
ALLPHA_TEXTGEN_MAX_PROMPT_BYTES=16384
ALLPHA_TEXTGEN_MAX_OUTPUT_TOKENS=1024
ALLPHA_TEXTGEN_MAX_LATENCY_MS=30000

# Optional ordered failover providers. Each fallback must serve the same model ID/version
# and pricing contract as the primary. A separate active tariff record is verified in
# Supabase for every provider. Failover is preflight-only; unknown provider outcomes are
# never replayed. Leave all fields blank to disable the fallback slot.
ALLPHA_TEXTGEN_FALLBACK_1_BASE_URL=
ALLPHA_TEXTGEN_FALLBACK_1_API_KEY=
ALLPHA_TEXTGEN_FALLBACK_1_PROVIDER_ID=
ALLPHA_TEXTGEN_FALLBACK_2_BASE_URL=
ALLPHA_TEXTGEN_FALLBACK_2_API_KEY=
ALLPHA_TEXTGEN_FALLBACK_2_PROVIDER_ID=
ALLPHA_TEXTGEN_FALLBACK_3_BASE_URL=
ALLPHA_TEXTGEN_FALLBACK_3_API_KEY=
ALLPHA_TEXTGEN_FALLBACK_3_PROVIDER_ID=

# WP-04 media worker secrets. Server-side only; never expose as EXPO_PUBLIC_*.
CLAMAV_HOST=
CLAMAV_PORT=3310
CONTENT_IMAGE_BATCH_SIZE=3
CONTENT_IMAGE_LEASE_SECONDS=180
CONTENT_TRANSCODE_BATCH_SIZE=2
CONTENT_RETENTION_POLL_SECONDS=300
CONTENT_SCHEDULER_POLL_SECONDS=5

# Cloudinary managed video/audio processing. Set in API (callback verification)
# and isolated transcode worker (upload); never in Web/Native client environments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=\nCLOUDINARY_WEBHOOK_API_SECRET= # optional dedicated notification-signature secret
ALLPHA_CLOUDINARY_CALLBACK_URL=https://api.allpha.web.id/v1/content/internal/providers/cloudinary/eager-callback

# Stripe billing (server-only). Disabled by default; never expose these to Web/Native.
# Configure only after Finance approves currency, prices, tax, refunds and settlement.
ALLPHA_STRIPE_ENABLED=false
ALLPHA_STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLPHA_STRIPE_API_VERSION=
ALLPHA_BILLING_ALLOWED_HOSTS=allpha.web.id,www.allpha.web.id
ALLPHA_BILLING_SUCCESS_URL=https://allpha.web.id/billing/success?session_id={CHECKOUT_SESSION_ID}
ALLPHA_BILLING_CANCEL_URL=https://allpha.web.id/billing

# Durable generation worker. Remains disabled until provider/model/cost/credit policy is approved.
ALLPHA_GENERATION_WORKER_ENABLED=false
ALLPHA_GENERATION_WORKER_POLL_SECONDS=5
ALLPHA_GENERATION_WORKER_BATCH_SIZE=5
