# Allpha API production/runtime environment template.
# Never commit real credentials. Set values in the existing Vercel api-allpha project environment.

ALLPHA_ENVIRONMENT=production
ALLPHA_CORS_ORIGINS=https://allpha.web.id,https://adm.allpha.web.id
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron authorization; server-side only, never expose to clients.
CRON_SECRET=

# Text generation is intentionally disabled until a provider, model, pricing,
# cost ceiling and explicit policy approval are configured. Compatible with an
# OpenAI Chat Completions-style endpoint; BASE_URL should include its API version.
ALLPHA_TEXTGEN_BASE_URL=
ALLPHA_TEXTGEN_API_KEY=
ALLPHA_TEXTGEN_PROVIDER_ID=
ALLPHA_TEXTGEN_MODEL_ID=
ALLPHA_TEXTGEN_MODEL_VERSION=
ALLPHA_TEXTGEN_POLICY_ID=
ALLPHA_TEXTGEN_POLICY_VERSION=
ALLPHA_TEXTGEN_POLICY_APPROVED=false
ALLPHA_TEXTGEN_PRICING_VERSION=
ALLPHA_TEXTGEN_COST_UNIT=USD
# Cost values are in the smallest configured currency unit (for USD, microdollars).
# Do not guess these; copy from the selected provider's current pricing contract.
ALLPHA_TEXTGEN_INPUT_MICRO_COST_PER_TOKEN=
ALLPHA_TEXTGEN_OUTPUT_MICRO_COST_PER_TOKEN=
ALLPHA_TEXTGEN_MAX_COST_MICROUNITS=
ALLPHA_TEXTGEN_MAX_PROMPT_BYTES=16384
ALLPHA_TEXTGEN_MAX_OUTPUT_TOKENS=1024
ALLPHA_TEXTGEN_MAX_LATENCY_MS=30000

# WP-04 media worker secrets. Server-side only; never expose as EXPO_PUBLIC_*.
CLAMAV_HOST=
CLAMAV_PORT=3310
CONTENT_IMAGE_BATCH_SIZE=3
CONTENT_IMAGE_LEASE_SECONDS=180
CONTENT_TRANSCODE_BATCH_SIZE=2
CONTENT_RETENTION_POLL_SECONDS=300
CONTENT_SCHEDULER_POLL_SECONDS=5

# Cloudinary managed video/audio processing. Set in API (callback verification)
# and isolated transcode worker (upload); never in Web/Native client environments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ALLPHA_CLOUDINARY_CALLBACK_URL=https://api.allpha.web.id/v1/content/internal/providers/cloudinary/eager-callback
