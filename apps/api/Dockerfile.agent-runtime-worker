FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ALLPHA_AGENT_RUNTIME_WORKER_ENABLED=false

WORKDIR /app
# The shared worker is resource-constrained. Malware scanning is delegated to
# the authenticated remote scanner contract; local ClamAV belongs only on a
# separately provisioned memory-eligible worker image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gosu ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home worker
COPY pyproject.toml ./
COPY src ./src
COPY docker/shared-worker-entrypoint.sh /usr/local/bin/shared-worker-entrypoint
RUN pip install --no-cache-dir . \
    && chmod 0755 /usr/local/bin/shared-worker-entrypoint \
    && sh -n /usr/local/bin/shared-worker-entrypoint

ENTRYPOINT ["/usr/local/bin/shared-worker-entrypoint"]
CMD ["allpha-agent-runtime-worker"]
