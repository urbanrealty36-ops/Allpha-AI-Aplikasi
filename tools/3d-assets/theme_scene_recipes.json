    "stable asset_id and source commit/path",
    "SHA-256 and GLB v2 parse validation",
    "per-file license evidence and attribution obligations",
    "texture/dependency inventory",
    "scale/origin/pivot and bounds metadata",
    "renderer compatibility check against project renderer",
    "mobile memory, triangle, material, texture and draw-call budgets",
    "accessibility/reduced-motion fallback",
